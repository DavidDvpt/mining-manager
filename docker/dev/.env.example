# Local development environment for the Mining Manager backend.
# Copy to `.env` (next to this file) and edit if needed.
# Join the dev network; safe local-only values, no production credentials.

# API host port
API_PORT=8040

# PostgreSQL host port
PG_PORT=5440

# Comma-separated allowed CORS origins
CORS_ORIGINS=
API_V1_PREFIX=
INTERNAL_V1_PREFIX=

# n8n local UI -> http://127.0.0.1:5679
# n8n stores its tables in the persistent local `entropia` PostgreSQL database.
# This key is only for n8n credential encryption; keep it stable locally.
N8N_ENCRYPTION_KEY=change_me_local_dev_only_long_random_string

# Redis 7, local development only
REDIS_PORT=6340
WIKI_BASE_URL=http://www.entropiawiki.com
IMAGES_BASE_URL=http://www.entropiawiki.com/images/gallery
IMAGES_DELAY_MS=1500
PAGES_DELAY_MS=0

# JWT secrets/expiries (local development only)
JWT_ACCESS_SECRET=change_me_dev_access_secret
JWT_REFRESH_SECRET=change_me_dev_refresh_secret

JWT_ACCESS_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# System user used by system-created data
SYSTEM_USER_ID=00000000-0000-0000-0000-000000000001

NEXUS_API_URL=https://api.entropianexus.com
