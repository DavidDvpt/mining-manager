# Non-secret production Compose settings.
# On the server, Bitwarden injects the secret variables with `bws run`.

IMAGE_TAG=latest
DOCKERHUB_NAMESPACE=lamouche42
API_V1_PREFIX=/api/v1
INTERNAL_V1_PREFIX=/internal/v1
CORS_ORIGINS=https://mining-manager.example.com

# These are required at runtime and should come from Bitwarden:
# DB_SCHEME
# DB_HOST
# DB_PORT
# DB_NAME_MM
# DB_USER_MM
# DB_PASSWORD
# JWT_ACCESS_SECRET
# JWT_REFRESH_SECRET
# INTERNAL_API_TOKEN
