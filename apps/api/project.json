{
  "name": "api",
  "projectType": "application",
  "sourceRoot": "apps/api/src",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run pytest --ignore=tests/integration",
        "cwd": "{projectRoot}"
      }
    },
    "test-integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash docker/test/run-integration.sh",
        "cwd": "{workspaceRoot}"
      }
    },
    "alembic": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "upgrade": {
          "command": "uv run alembic upgrade head"
        }
      }
    }
  }
}
